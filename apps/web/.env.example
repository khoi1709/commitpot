# Default is a clearly labelled local synthetic demonstration.
NEXT_PUBLIC_USE_MOCK=true
# For a locally deployed contract + injected wallet, set false and these public values.
NEXT_PUBLIC_CHAIN_MODE=local
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_COMMITPOT_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
# Never put a private key, seed phrase or wallet credential in NEXT_PUBLIC_*.
