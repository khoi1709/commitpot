{
  "name": "commitpot",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @commitpot/web dev",
    "build": "pnpm --filter @commitpot/web build",
    "typecheck": "pnpm --filter @commitpot/web typecheck",
    "test:web": "pnpm --filter @commitpot/web test",
    "test:contracts": "powershell.exe -NoProfile -File scripts/ci/test-contracts.ps1",
    "test:integration": "powershell.exe -NoProfile -File scripts/ci/run-integration.ps1",
    "test": "pnpm test:web && pnpm test:contracts"
  }
}
